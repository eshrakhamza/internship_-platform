# Shared secret with NestJS — generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# Groq (primary LLM — free tier, https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (fallback + vision, https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3

# Tesseract binary path (Windows — adjust to your install)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
