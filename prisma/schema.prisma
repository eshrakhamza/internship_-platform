generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  firstName       String
  lastName        String
  phoneNumber     String?
  role            UserRole  @default(CANDIDATE)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  
  // Relationships
  candidate       Candidate?
  recruiterNotes  RecruiterNote[] @relation("RecruiterNotes")
  emailLogs       EmailLog[]
  statusHistories StatusHistory[] @relation("StatusHistories")
  reviewedResults     AssessmentResult[]
  campaigns           AssessmentCampaign[]
  
  @@map("users")
}

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

model Candidate {
  id                  String    @id @default(uuid())
  userId              String    @unique
  school              String?
  academicLevel       String?
  graduationYear      Int?
  preferredTheme      Theme?
  cvFileId            String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Relationships
  user                User      @relation(fields: [userId], references: [id])
  application         Application?
  cvFile              File?     @relation(fields: [cvFileId], references: [id])
  attempts            Attempt[]
  recruiterNotes      RecruiterNote[] @relation("CandidateNotes")
  statusHistories     StatusHistory[] @relation("CandidateStatusHistories")
  aiAnalyses          AIAnalysis[]

  @@map("candidates")
}

enum Theme {
  ARTIFICIAL_INTELLIGENCE
  CYBERSECURITY
  DEVOPS
  DATA_SCIENCE
  FULL_STACK
  CLOUD_COMPUTING
  SOFTWARE_ENGINEERING
}

model Application {
  id                  String                @id @default(uuid())
  candidateId         String                @unique
  status              ApplicationStatus     @default(APPLIED)
  answerQuestion1     String
  answerQuestion2     String
  answerQuestion3     String
  answerQuestion4     String
  answerQuestion5     String
  answerQuestion6     String
  submittedAt         DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  reviewedAt          DateTime?
  reviewedBy          String?
  
  // Relationships
  candidate           Candidate             @relation(fields: [candidateId], references: [id])
  aiAnalysis          AIAnalysis?
  recruiterNotes      RecruiterNote[]       @relation("ApplicationNotes")
  statusHistories     StatusHistory[]       @relation("ApplicationStatusHistories")

  @@map("applications")
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  TEST_INVITED
  TEST_COMPLETED
  ACCEPTED
  REJECTED
}

model File {
  id              String    @id @default(uuid())
  filename        String
  originalName    String
  mimeType        String
  path            String
  size            Int
  uploadedAt      DateTime  @default(now())
  
  // Relationships
  cvFile          Candidate?

  @@map("files")
}

model StatusHistory {
  id              String            @id @default(uuid())
  applicationId   String
  candidateId     String
  status          ApplicationStatus
  changedBy       String
  changedAt       DateTime          @default(now())
  notes           String?
  
  // Relationships
  application   Application  @relation("ApplicationStatusHistories", fields: [applicationId], references: [id])
candidate     Candidate    @relation("CandidateStatusHistories", fields: [candidateId], references: [id])
user          User         @relation("StatusHistories", fields: [changedBy], references: [id])

  @@map("status_histories")
}

model RecruiterNote {
  id              String    @id @default(uuid())
  content         String
  category        NoteCategory @default(GENERAL)
  recruiterId     String
  candidateId     String
  applicationId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relationships
  recruiter       User      @relation(fields: [recruiterId], references: [id], name: "RecruiterNotes")
  candidate       Candidate @relation(fields: [candidateId], references: [id], name: "CandidateNotes")
  application     Application? @relation(fields: [applicationId], references: [id], name: "ApplicationNotes")

  @@map("recruiter_notes")
}

enum NoteCategory {
  GENERAL
  STRENGTH
  WEAKNESS
  OBSERVATION
}

model AIAnalysis {
  id                      String    @id @default(uuid())
  applicationId           String    @unique
   candidateId               String
   
  candidateSummary        String
  themeClassification     Theme
  recommendationScore     Int      
  recommendationExplanation String
  generatedAt             DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  
  // Relationships
  application             Application @relation(fields: [applicationId], references: [id])
  candidate                 Candidate @relation(fields: [candidateId], references: [id])


  @@map("ai_analyses")

}

model AssessmentCampaign {
  id                      String    @id @default(uuid())
  title                   String
  description             String?
  theme                   Theme
  difficulty              Difficulty @default(INTERMEDIATE)
  durationMinutes         Int       @default(60)
  status                  CampaignStatus @default(DRAFT)
  createdBy               String
  publishedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  
  // Relationships
  questions               Question[]
  attempts                Attempt[]
  creator                 User      @relation(fields: [createdBy], references: [id])

  @@map("assessment_campaigns")
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Question {
  id                      String    @id @default(uuid())
  campaignId              String
  type                    QuestionType @default(MCQ)
  questionText            String
  explanation             String?
  order                   Int
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  
  // Relationships
  campaign                AssessmentCampaign @relation(fields: [campaignId], references: [id])
  options                 MCQOption[]
  attemptAnswers          AttemptAnswer[]

  @@map("questions")
}

enum QuestionType {
  MCQ
  OPEN
}

model MCQOption {
  id                      String    @id @default(uuid())
  questionId              String
  optionText              String
  isCorrect               Boolean   @default(false)
  order                   Int
  attemptAnswers AttemptAnswer[]
  // Relationships
  question                Question  @relation(fields: [questionId], references: [id])

  @@map("mcq_options")
}

model Attempt {
  id                      String    @id @default(uuid())
  candidateId             String
  campaignId              String
  status                  AttemptStatus @default(IN_PROGRESS)
  startedAt               DateTime  @default(now())
  completedAt             DateTime?
  mcqScore                Float?
  openQuestionsScore      Float?
  totalScore              Float?
  timeSpentSeconds        Int?
  
  // Relationships
  candidate               Candidate @relation(fields: [candidateId], references: [id])
  campaign                AssessmentCampaign @relation(fields: [campaignId], references: [id])
  answers                 AttemptAnswer[]
  result                  AssessmentResult?

  @@map("attempts")
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  TIMED_OUT
}

model AttemptAnswer {
  id                      String    @id @default(uuid())
  attemptId               String
  questionId              String
  selectedOptionId        String?   @unique
  openAnswer              String?
  score                   Float?
  feedback                String?
  strengths               String?
  weaknesses              String?
  evaluatedAt             DateTime?
  
  // Relationships
  attempt                 Attempt   @relation(fields: [attemptId], references: [id])
  question                Question  @relation(fields: [questionId], references: [id])
  selectedOption          MCQOption? @relation(fields: [selectedOptionId], references: [id])

  // Add this compound unique constraint
  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}
model AssessmentResult {
  id                      String    @id @default(uuid())
  attemptId               String    @unique
  mcqScore                Float
  openQuestionsScore      Float
  totalScore              Float
  ranking                 Int?
  reviewedBy              String?
  reviewedAt              DateTime?
  feedback                String?
  
  // Relationships
  attempt                 Attempt   @relation(fields: [attemptId], references: [id])
  reviewer                User?     @relation(fields: [reviewedBy], references: [id])

  @@map("assessment_results")
}

model EmailLog {
  id                      String    @id @default(uuid())
  recipient               String
  subject                 String
  content                 String
  type                    EmailType
  status                  EmailStatus @default(SENT)
  sentAt                  DateTime  @default(now())
  errorMessage            String?
  userId                  String
  
  // Relationships
  user                    User      @relation(fields: [userId], references: [id])

  @@map("email_logs")
}

enum EmailType {
  OTP
  APPLICATION_CONFIRMATION
  SHORTLISTED
  TEST_INVITATION
  ACCEPTANCE
  REJECTION
}

enum EmailStatus {
  SENT
  FAILED
}